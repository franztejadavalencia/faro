# Plantilla. Copiar a .env.development (faro_dev) y .env.test (faro_test, debe terminar
# en _test) con valores reales. Los .env.* reales están ignorados por git.
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=faro_dev
DB_USER=postgres
DB_PASSWORD=cambiar

JWT_SECRET=cambiar

# Clave de 32 bytes en base64 para cifrar totp_secreto (B5): openssl rand -base64 32
TOTP_CLAVE_CIFRADO=cambiar

# Origen del frontend permitido por CORS (varios, separados por coma)
CORS_ORIGIN=http://localhost:4200

# Vacío = sin proxy (se usa request.ip). Detrás de un proxy confiable: valor de
# Express para 'trust proxy' (número de proxies, p. ej. 1, o loopback, IPs, subredes).
# No acepta true ni false.
TRUST_PROXY=

# Solo en production: true publica Swagger en /api/docs. En development y test siempre está.
SWAGGER=

# Admin de plataforma (npm run seed:admin; solo lo lee el seed). ADMIN_CLAVE: mínimo 8
# caracteres y máximo 72 bytes. En production el admin nace con debe_cambiar_clave = true;
# tras sembrar, borra ADMIN_CLAVE de .env.production (el seed no pisa una clave existente).
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambiar-por-una-clave-larga
ADMIN_NOMBRE=Administrador de plataforma
