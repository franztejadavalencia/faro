# Plantilla. Copiar a .env.development (faro_dev) y .env.test (faro_test, debe terminar
# en _test) con valores reales. Los .env.* reales están ignorados por git.
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=faro_dev
DB_USER=postgres
DB_PASSWORD=cambiar

# Firma los JWT (HS256). Mínimo 32 caracteres; vacío, la app no arranca. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# (64 caracteres, 384 bits). Nunca copies un valor de ejemplo a un .env real.
JWT_SECRET=

# Cifra totp_secreto (AES-256-GCM, B5): base64 de exactamente 32 bytes; vacía o mal formada,
# la app no arranca. Una distinta por entorno. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perderla o cambiarla deja ilegibles los secretos TOTP (todos enrolan de nuevo): en producción,
# respáldala fuera del servidor junto con JWT_SECRET. Nunca copies un valor de ejemplo.
TOTP_CLAVE_CIFRADO=

# Origen del frontend permitido por CORS (varios, separados por coma)
CORS_ORIGIN=http://localhost:4200

# Vacío = sin proxy (se usa request.ip). Detrás de un proxy confiable: valor de
# Express para 'trust proxy' (número de proxies, p. ej. 1, o loopback, IPs, subredes).
# No acepta true ni false.
TRUST_PROXY=

# Solo en production: true publica Swagger en /api/docs. En development y test siempre está.
SWAGGER=

# Admin de plataforma (npm run seed:admin; solo lo lee el seed). ADMIN_CLAVE: mínimo 8
# caracteres y máximo 72 bytes. En production el admin nace con debe_cambiar_clave = true;
# tras sembrar, borra ADMIN_CLAVE de .env.production (el seed no pisa una clave existente).
# ADMIN_CLAVE va vacía aquí: un valor de ejemplo copiado a un .env real sería una clave conocida.
ADMIN_USUARIO=admin
ADMIN_CLAVE=
ADMIN_NOMBRE=Administrador de plataforma
