{
  "name": "faro-backend",
  "version": "0.0.1",
  "description": "API de FARO",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": "10.9.x"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:generate": "cross-env NODE_ENV=development npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:run": "cross-env NODE_ENV=development npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "cross-env NODE_ENV=development npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "migration:show": "cross-env NODE_ENV=development npm run typeorm -- migration:show -d src/database/data-source.ts",
    "migration:run:test": "cross-env NODE_ENV=test npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert:test": "cross-env NODE_ENV=test npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "migration:show:test": "cross-env NODE_ENV=test npm run typeorm -- migration:show -d src/database/data-source.ts",
    "seed:admin": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/database/seeds/seed-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.3",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "decimal.js": "10.6.0",
    "dotenv": "16.4.5",
    "pg": "8.13.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.13",
    "@types/node": "20.16.11",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.8.1",
    "@typescript-eslint/parser": "8.8.1",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "jest": "29.7.0",
    "prettier": "3.5.3",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@seguridad/(.*)$": "<rootDir>/seguridad/$1",
      "^@plataforma/(.*)$": "<rootDir>/plataforma/$1",
      "^@catalogo/(.*)$": "<rootDir>/catalogo/$1",
      "^@inventario/(.*)$": "<rootDir>/inventario/$1",
      "^@compras/(.*)$": "<rootDir>/compras/$1",
      "^@ventas/(.*)$": "<rootDir>/ventas/$1",
      "^@gastos/(.*)$": "<rootDir>/gastos/$1",
      "^@contabilidad/(.*)$": "<rootDir>/contabilidad/$1",
      "^@cierre/(.*)$": "<rootDir>/cierre/$1",
      "^@analisis/(.*)$": "<rootDir>/analisis/$1",
      "^@database/(.*)$": "<rootDir>/database/$1"
    },
    "globalSetup": "<rootDir>/../test/jest-global-setup.js"
  }
}
