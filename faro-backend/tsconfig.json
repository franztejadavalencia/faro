{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@common/*": ["src/common/*"],
      "@seguridad/*": ["src/seguridad/*"],
      "@plataforma/*": ["src/plataforma/*"],
      "@catalogo/*": ["src/catalogo/*"],
      "@inventario/*": ["src/inventario/*"],
      "@compras/*": ["src/compras/*"],
      "@ventas/*": ["src/ventas/*"],
      "@gastos/*": ["src/gastos/*"],
      "@contabilidad/*": ["src/contabilidad/*"],
      "@cierre/*": ["src/cierre/*"],
      "@analisis/*": ["src/analisis/*"],
      "@database/*": ["src/database/*"]
    }
  }
}
